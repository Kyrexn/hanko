{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanko",
  "version": "1.3.0",
  "identifier": "com.julio.hanko",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hanko",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0B0A09"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://icons.duckduckgo.com; connect-src 'self' ipc: http://ipc.localhost https://api.pwnedpasswords.com https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBRDJGNTlEQjNGRjUyQUYKUldTdlV2K3puZlhTcWdocEx2SUpoY21NYm1HSUZxNnRUNUZ6dUhpWWYzNTQ0ZjdjR2ovTWhKVGkK",
      "endpoints": [
        "https://kldvivevydcbjhveqibf.supabase.co/storage/v1/object/public/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "publisher": "Hanko",
    "copyright": "© 2026 Julio — Hanko",
    "shortDescription": "Hanko — senhas e 2FA, selados",
    "longDescription": "Gerenciador de senhas e códigos 2FA com criptografia de ponta a ponta, sincronização e Kit de Emergência.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Hanko",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
